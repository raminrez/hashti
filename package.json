{
  "name": "hashti-new",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "typescript": "~7.0.2",
      "@ui-sdk/react": "^0.1.0-beta.13",
      "@ui-sdk/core": "^0.1.0-beta.13",
      "oxlint": "^1.94.0",
      "tsrs": "^7.1.0-beta.tsrs3",
      "stylelint": "^18.1.0",
      "stylelint-config-standard": "^41.1.0",
      "lefthook": "^2.2.2",
      "knip": "^6.46.1",
      "jscpd": "^5.4.3",
      "bun-types": "^1.4.5"
    }
  },
  "scripts": {
    "dev": "bun --filter docs dev",
    "build": "bun --filter docs build",
    "typecheck": "bun --filter '*' types:check",
    "lint": "bun run --bun oxlint",
    "lint:fix": "bun run lint --fix",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "test": "bun test",
    "lint:css": "stylelint \"packages/styles/**/*.css\"",
    "deadcode": "knip",
    "deps:check": "bun run scripts/check-workspace-deps.ts",
    "duplicates": "jscpd && jscpd --config .jscpd.markup.json",
    "contrast": "node design-system/scripts/contrast-audit.mjs",
    "duplicates:new": "jscpd --baseline-from-ref dev --fail-on-new-clones && jscpd --config .jscpd.markup.json --baseline-from-ref dev --fail-on-new-clones",
    "react-doctor": "npx -y --min-release-age=7 react-doctor@latest --no-telemetry --no-supply-chain",
    "prepare": "lefthook install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.8",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/addon-mcp": "^10.6.8",
    "@storybook/addon-themes": "^10.6.8",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "apca-w3": "^0.1.9",
    "bun-types": "catalog:",
    "jscpd": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "playwright": "latest",
    "storybook": "^10.6.8",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "tsrs": "catalog:",
    "vitest": "latest"
  }
}
