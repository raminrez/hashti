{
  "name": "@hashti/react",
  "version": "0.1.0-alpha.1",
  "description": "Hashti modern React components, built on React Aria Components.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Ramin Rezaei <raminxrez@gmail.com>",
  "homepage": "https://hashti.raminrez.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raminrez/hashti.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/raminrez/hashti/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "react-aria-components",
    "design-system",
    "components",
    "hashti"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
