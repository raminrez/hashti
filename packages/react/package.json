    "./styles.css": "./dist/styles.css",
    "./dist/*": "./dist/*"
  },
  "peerDependencies": {
    "@hashti/tokens": "workspace:*",
    "react": ">=19.0.0 <20",
    "react-dom": ">=19.0.0 <20",
    "react-aria-components": ">=1.22.0 <2"
  },
  "dependencies": {
    "@hashti/agent": "workspace:*",
    "@internationalized/date": "catalog:"
  },
  "devDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-aria-components": "catalog:",
    "@types/react": "catalog:"
  }
