---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<!-- Hashti tokens key on data-theme (light, dark, system). Fumadocs' toggle
     only flips class="dark" on <html>, so this script mirrors the class onto
     data-theme; the observer keeps it in sync across toggles and client-side
     navigations. -->
<html lang="en" data-theme="light" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {image && <meta property="og:image" content={image} />}
    <ClientRouter />
    <script is:inline>
      const root = document.documentElement;
      const syncTheme = () => {
        root.dataset.theme = root.classList.contains("dark") ? "dark" : "light";
      };
      syncTheme();
      // Re-runs on view-transition navigation; replace the old observer so
      // they don't pile up.
      window.__hashtiThemeSync?.disconnect();
      window.__hashtiThemeSync = new MutationObserver(syncTheme).observe(
        root,
        { attributes: true, attributeFilter: ["class"] },
      );
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <slot />
  </body>
</html>
