{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "react", "jsx-a11y"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true
      }
    ],
    "react/rules-of-hooks": "error",
    "jsx-a11y/anchor-has-content": "off",
    "jsx-a11y/no-noninteractive-tabindex": [
      "error",
      {
        "tags": ["pre"],
        "roles": ["tabpanel", "region"]
      }
    ],
    "jsx-a11y/no-redundant-roles": [
      "error",
      {
        "table": ["table"]
      }
    ],
    "jsx-a11y/prefer-tag-over-role": "off",
    "react/react-in-jsx-scope": "off",
    "typescript/restrict-template-expressions": "off"
  },
  "settings": {
    "jsx-a11y": {
      "components": {
        "Dialog": "dialog",
        "Checkbox": "input",
        "CheckboxIndicator": "input",
        "Radio": "input",
        "RadioIndicator": "input",
        "RadioGroup": "radiogroup",
        "Switch": "input",
        "SwitchThumb": "input",
        "Input": "input",
        "Textarea": "textarea"
      }
    }
  },
  "options": {
    "maxWarnings": 0,
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.git/**",
    "**/.astro/**",
    ".research/**",
    ".tools/**",
    ".taste-skill/**",
    "test-results/**",
    // Generator-owned Storybook Workbench wrappers/decorators: fixes belong upstream; their TS
    // config path differs from this repo root, so type-aware checks cannot resolve react here.
    ".storybook/wrappers/**",
    ".storybook/decorators/**",
    ".agents",
    ".claude"
  ]
}
