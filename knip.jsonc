{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Vendored agent-skill assets; not project code, never shipped.
  "ignore": [
    "**/.agents/**",
    // Generated by Storybook Workbench scaffold; consumed by its own stories, not by app code.
    ".storybook/wrappers/**",
    ".storybook/decorators/**",
    // Standalone audit script, run directly with bun (see sb-flows phase); never imported.
    ".storybook/scripts/**",
  ],
  "ignoreDependencies": [
    // oxlint's type-aware backend (tsgolint) — a runtime binary, never imported
    "tsrs",
    // Ambient Bun/Node types for scripts/tsconfig.json; referenced only from
    // tsconfig `types`, so knip sees no import.
    "bun-types",
  ],
  "ignoreIssues": {
    // Root devDependencies reference the catalog for shared version pinning;
    // knip's catalog plugin only counts member-workspace references.
    "package.json": ["catalog"],
  },
  "workspaces": {
    // Repo-level scripts (deps:check, …) run via package.json scripts, never imported.
    ".": { "entry": ["scripts/*.ts"] },
    "packages/react": {},
    "packages/utils": {},
    "packages/styles": {},
    "apps/docs": {
      "entry": ["src/**/*.astro", "src/**/*.ts", "src/**/*.tsx"],
    },
  },
}
