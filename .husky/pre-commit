# Pre-commit: check only what changed.
# Format → lint JS/TS → lint CSS → typecheck changed workspaces.

# 1. Format staged files (bun fmt restages what it changes).
bun fmt --staged

staged () { git diff --cached --name-only --diff-filter=ACMR | grep -E "$1" || true; }

ts_files=$(staged '\.(ts|tsx|js|mjs)$')
css_files=$(staged '\.css$')

# 2. Lint staged JS/TS.
if [ -n "$ts_files" ]; then
  bunx oxlint $ts_files || exit 1
fi

# 3. Lint staged CSS.
if [ -n "$css_files" ]; then
  bunx stylelint $css_files || exit 1
fi

# 4. Typecheck each workspace with staged files (tsc is project-wide, so
#    we scope by workspace, not by file).
workspaces=""
while IFS= read -r f; do
  case "$f" in
    packages/utils/*) w="utils" ;;
    packages/react/*) w="react" ;;
    apps/docs/*)      w="docs" ;;
    *)                w="" ;;
  esac
  [ -n "$w" ] && case ",$workspaces," in *",$w,"*) ;; *) workspaces="$workspaces,$w" ;; esac
done <<EOF2
$(staged '\.(ts|tsx|json)$')
EOF2

for w in ${workspaces#,}; do
  bun --filter "$w" types:check || exit 1
done
